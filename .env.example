# Required: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram numeric user IDs allowed to use the bot.
# Get yours by DMing @userinfobot. The daemon refuses to start if this is empty.
TG_ALLOWED_USER_IDS=

# Required: Cursor API key from https://cursor.com/dashboard.
# `agent login` credentials don't reliably persist for headless mode, so the
# env var is the recommended path.
CURSOR_API_KEY=

# Default workspace directory (the agent's working tree).
# Per-chat /cd <path> overrides this at runtime.
DEFAULT_WORKSPACE=

# Optional: explicit path to the agent binary.
# Default: searches PATH, falls back to ~/.local/bin/agent.
# AGENT_BIN=/Users/you/.local/bin/agent

# Optional: model override (e.g. composer-2-fast, gpt-5.2).
# Default: agent's choice. Run `agent --list-models` for the list.
# AGENT_MODEL=

# Max wall time for one agent invocation, in seconds.
AGENT_TIMEOUT_SEC=600

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
